{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kima1810/CH2K8-recomp/blob/ZMO-beta1/docs/formats/chmod.schema.json",
  "title": "CHMOD 1 / mod API 1.2.0 Xbox data and verified extension profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "author", "version", "requires", "content", "capabilities", "dependencies", "incompatible", "assets"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "name": {"$ref": "#/$defs/label"},
    "author": {"$ref": "#/$defs/label"},
    "version": {"$ref": "#/$defs/version"},
    "requires": {
      "type": "object", "additionalProperties": false,
      "required": ["xex_sha256", "recomp", "mod_api"],
      "properties": {
        "xex_sha256": {"$ref": "#/$defs/hash"},
        "recomp": {"const": "ZMO-beta1"},
        "mod_api": {"enum": ["1.0.0", "1.1.0", "1.2.0"]}
      }
    },
    "content": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["assets", "rosters", "code"]}},
    "capabilities": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["dds.replace", "cloth.positions", "roster.expose", "uniform.register", "hook.player.weight.read"]}},
    "extensions": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["file", "sha256", "abi", "hook"],
        "properties": {
          "file": {"type": "string", "maxLength": 220, "pattern": "^code/[A-Za-z0-9_.-]+\\.dll$"},
          "sha256": {"$ref": "#/$defs/hash"}, "abi": {"const": 1}, "hook": {"const": "player.weight.read"}
        }
      }
    },
    "uniforms": {
      "type": "array", "minItems": 2, "maxItems": 64,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["name", "template_hash", "template_layout_sha256", "folder", "files"],
        "properties": {
          "name": {"type": "string", "pattern": "^(?:sel)?u[haxyz][0-9]{3,4}\\.iff$"},
          "template_hash": {"$ref": "#/$defs/u32"}, "template_layout_sha256": {"$ref": "#/$defs/hash"},
          "folder": {"type": "string", "maxLength": 220, "pattern": "^uniforms/(?:sel)?u[haxyz][0-9]{3,4}\\.iff$"},
          "files": {"type": "array", "minItems": 2, "maxItems": 4096, "items": {
            "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
            "properties": {"path": {"type": "string", "maxLength": 220, "pattern": "^[A-Za-z0-9_./-]+$"}, "sha256": {"$ref": "#/$defs/hash"}}
          }}
        }
      }
    },
    "roster": {
      "type": "object", "additionalProperties": false, "required": ["file", "sha256", "header", "header_sha256"],
      "properties": {
        "file": {"type": "string", "maxLength": 220, "pattern": "^rosters/.+\\.ROS$"},
        "sha256": {"$ref": "#/$defs/hash"},
        "header": {"type": "string", "maxLength": 220, "pattern": "^rosters/.+\\.header$"},
        "header_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "dependencies": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "version"],
        "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/version"}}
      }
    },
    "incompatible": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "update_source": {
      "type": "object", "additionalProperties": false, "required": ["url"],
      "properties": {"url": {"type": "string", "maxLength": 512, "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases(?:/.*)?$"}}
    },
    "assets": {
      "type": "array", "minItems": 0, "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["bank_hash", "record_index", "record_id", "record_type", "target", "source_sha256", "file", "sha256"],
        "properties": {
          "bank_hash": {"$ref": "#/$defs/u32"},
          "record_index": {"$ref": "#/$defs/u32"},
          "record_id": {"$ref": "#/$defs/u32"},
          "record_type": {"enum": [1547079785, 3798768477]},
          "kind": {"enum": ["dds.replace", "cloth.positions"]},
          "component": {"const": 0},
          "target": {"type": "string", "maxLength": 220},
          "source_sha256": {"$ref": "#/$defs/hash"},
          "file": {"type": "string", "maxLength": 220},
          "sha256": {"$ref": "#/$defs/hash"}
        },
        "allOf": [{
          "if": {"required": ["kind"], "properties": {"kind": {"const": "cloth.positions"}}},
          "then": {"required": ["component"], "properties": {
            "record_type": {"const": 3798768477},
            "target": {"pattern": "^assets/[^/]+\\.iff/[^/]+\\.scne/block0\\.dat$"},
            "file": {"pattern": "^assets/.+\\.dat$"}
          }},
          "else": {"not": {"required": ["component"]}, "properties": {
            "record_type": {"const": 1547079785},
            "target": {"pattern": "^assets/[^/]+\\.iff/[^/]+\\.txtr/texture\\.dds$"},
            "file": {"pattern": "^assets/.+\\.dds$"}
          }}
        }]
      }
    }
  },
  "allOf": [{
    "if": {"required": ["roster"]},
    "then": {"properties": {"requires": {"properties": {"mod_api": {"enum": ["1.1.0", "1.2.0"]}}}}}
  }, {
    "if": {"properties": {"assets": {"maxItems": 0}}},
    "then": {"anyOf": [{"required": ["roster"]}, {"required": ["uniforms"]}, {"required": ["extensions"]}]}
  }, {
    "if": {"properties": {"assets": {"contains": {"required": ["kind"], "properties": {"kind": {"const": "cloth.positions"}}}}}},
    "then": {"properties": {"requires": {"properties": {"mod_api": {"enum": ["1.1.0", "1.2.0"]}}}}}
  }, {
    "if": {"required": ["uniforms"]},
    "then": {"required": ["roster"], "properties": {"requires": {"properties": {"mod_api": {"const": "1.2.0"}}}}}
  }, {
    "if": {"required": ["extensions"]},
    "then": {"properties": {"requires": {"properties": {"mod_api": {"const": "1.2.0"}}}}}
  }],
  "$defs": {
    "id": {"type": "string", "maxLength": 512, "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "label": {"type": "string", "maxLength": 120, "pattern": "^[^\\x00-\\x1f]{1,120}$"},
    "version": {"type": "string", "maxLength": 512, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "u32": {"type": "integer", "minimum": 0, "maximum": 4294967295}
  }
}
